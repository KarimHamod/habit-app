# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# supabase
/supabase/.branches
/supabase/.temp

# graphify knowledge graph (local dev aid, not for version control)
/graphify-out/

# claude code: personal-machine config and locally-installed skill tooling
# (settings.local.json is the personal-override file by convention; the
# impeccable skill/agents pull in a ~16MB platform-specific compiled binary
# under scripts/bin, not app source)
/.claude/settings.local.json
/.claude/skills/
/.claude/agents/
