NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Comma-separated list of emails allowed to sign up. Leave unset
